<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FocusFlow" parent="android:Theme.Material.NoActionBar">
        <!-- Deep Obsidian & Lime Zen Backgrounds -->
        <item name="android:windowBackground">#0F1014</item>
        <item name="android:colorBackground">#0F1014</item>
        
        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">#0F1014</item>
        <item name="android:navigationBarColor">#0F1014</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Android 12+ (API 31+) System Splash Screen -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#0F1014</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
